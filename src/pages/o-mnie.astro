---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import zofiaIBari from "../assets/zofia_i_bari_na_lawce.jpg";
import oczyZblizenie from "../assets/oczyZblizenie.jpg";
---

<Layout>
    <Header />
    <div>
        <img id="oczy" src={oczyZblizenie.src} alt="Tlo" />
        <div>
            <h3>O mnie</h3>

            <span>~ Pozwolę się przedstawić ~</span>
        </div>
    </div>
    <section>
        <h4>Cześć</h4>
        <h5>Nazywam się Zofia</h5>
        <p>
            Na co dzień uczę opiekunów jak rozmawiać ze swoimi psami jako
            behawiorystka oraz dbam o zdrową sierść czworonogów jako fryzjerka.
            Z wykształcenia jestem technikiem weterynarii, więc można
            powiedzieć, że 3w1 :) Sprawdź, jak mogę pomóc Tobie!
        </p>
        <a href="/oferta" class="action-call">
            Oferta
        </a>
        <img id="glowne" src={zofiaIBari.src} alt="Zofia i Bari" />
    </section>
    <Footer />
</Layout>

<style>
    div {
        position: relative;
        height: clamp(10rem, 13dvh, 40rem);
    }
    img#oczy {
        top: 0;
        position: absolute;
        height: clamp(10rem, 13dvh, 40rem);
        width: 100%;
        object-fit: cover;
        filter: sepia(0.1) brightness(0.7) contrast(1.1);
    }
    h3,
    span {
        color: var(--color-text2);
    }
    h3 {
        font-size: 2.4rem;
    }
    span {
        font-size: 1.8rem;
    }
    #home {
        transform: translateY(0.4rem);
    }
    div > div {
        position: absolute;
        bottom: 0px;
        display: flex;
        flex-direction: column;
        justify-content: end;
        padding: 1rem;
    }
    section {
        padding: clamp(3dvw, 8%, 0dvw);
        background-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-bg2));
        perspective: 1000px;
        
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
    }
    h4 {
        font-size: 3.5rem;
    }
    h5 {
        font-size: 2.8rem;
    }
    p {
        font-size: 1.3rem;
    }
    img#glowne {
        filter: drop-shadow(3px 3px 1px var(--color-shadow));
        margin-top: 2rem;
        border-radius: var(--border-radius-small);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        transform-style: preserve-3d;
    }
    img#glowne:hover {
        transform: rotateY(7deg) rotateX(5deg) scale(1.05);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }
    @media screen and (min-width: 800px) {
        img#glowne {
            position: absolute;
            height: clamp(10rem, 30dvw, 35rem);
            right: 10%;
            top: 10%;
        }
        p, h4, h5 {
            max-width: 40%;
        }
        section {
            min-height: 40rem;
            position: relative;
            display: block;
        }

    }
     
</style>
<script defer>
    const card = document.querySelector('section');
    const cardInner = document.querySelector('img#glowne');

    card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left; // Mouse X inside card
        const y = e.clientY - rect.top;  // Mouse Y inside card

        // Calculate rotation: center is 0,0
        const rotateX = ((y / rect.height) - 0.5) * 40; // tilt up/down
        const rotateY = ((x / rect.width) - 0.5) * -40; // tilt left/right

        cardInner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });

    card.addEventListener('mouseleave', () => {
        cardInner.style.transform = 'rotateX(0) rotateY(0)';
    });
</script>