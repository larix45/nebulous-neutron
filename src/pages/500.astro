---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="error-page">
    <div class="error-inner container">
      <div class="error-graphic" aria-hidden="true">
        <!-- TU wstaw swoją grafikę -->
      </div>
      <h1>500 – Błąd serwera</h1>
      <p>Ups! Coś poszło nie tak po stronie serwera. Spróbuj ponownie za chwilę lub odśwież stronę.</p>
      <a class="error-button" href="/">Powrót na start</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
.error-page {
  min-height: calc(100vh - 160px);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg2);
  color: var(--color-text);
}

.error-inner {
  text-align: center;
  border: 1px solid rgba(0, 0, 0, 0.08);
  background: rgba(255,255,255,0.95);
  border-radius: 1rem;
  padding: 2.5rem 1.5rem;
  box-shadow: 0 12px 24px rgba(0,0,0,0.08);
}

.error-graphic {
  width: 300px;
  height: 220px;
  margin: 0 auto 1.5rem;
  background: linear-gradient(135deg, #f8d7da, #fcebea);
  border-radius: 0.8rem;
  border: 1px dashed rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0,0,0,0.45);
  font-size: 0.95rem;
}

.error-graphic::before {
  content: "Miejsce na grafikę";
}

.error-page h1 {
  margin-top: 0;
  font-size: clamp(1.6rem, 4vw, 2.2rem);
}

.error-page p {
  margin: 0.6rem 0 1.4rem;
  color: #444;
}

.error-button {
  display: inline-block;
  padding: 0.75rem 1.3rem;
  border-radius: 0.6rem;
  border: 1px solid var(--color-primary);
  color: var(--color-primary);
  background: rgba(79, 70, 229, 0.07);
  font-weight: 700;
  transition: all 0.2s ease;
}

.error-button:hover {
  background: var(--color-primary);
  color: #fff;
}

@media (max-width: 768px) {
  .error-inner {
    padding: 2rem 1rem;
  }

  .error-graphic {
    width: 100%;
    max-width: 260px;
    height: 180px;
  }
}
a {
    text-decoration: none;
}
</style>
