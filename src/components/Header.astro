---
import logo from '../assets/logo.png'
import { Icon } from 'astro-icon/components'
---


<header id="back">
    <script defer>
        function toggle_menu()
        {
            if(document.getElementsByTagName("nav")[0].classList.contains("visible"))
                document.getElementsByTagName("nav")[0].classList.remove("visible");
            else
                document.getElementsByTagName("nav")[0].classList.add("visible");
        }
    </script>
    
    <a href="/" id="logo_i_tytul">
        <img src={logo.src} alt="Logo psie talarki">
        <div>
            <h1>Pjeski Talarka</h1>
            <h2>Zofia Talarczyk, behawiorystka</h2>
        </div>
    </a>
    <Icon id="hamburger" onclick="toggle_menu()" name="mdi:menu" size="48"/>
    <nav class="visible">
        <a href="/">Start</a>
        <a href="/o-mnie/">O mnie</a>
        <div class="dropdown" id="link_oferta">
            <details>
                <summary><a>Oferta</a> <Icon id="chevron" name="mdi:chevron-down" size="20"/></summary>
                <div class="dropdown-menu" aria-label="Oferta submenu">
                    <a href="/oferta/konsultacje-behawioralne">Konsultacja behawioralne</a>
                    <a href="/oferta/pielegnacja-psa">Pielęgnacja psa</a>
                    <a href="/oferta/trening-kooperacyjny">Trening kooperacyjny</a>
                    <a href="/oferta/spacery-socjalizacyjne">Spacery socjalizacyjne 1:1</a>
                    <a href="/oferta/spacery-behawioralne">Spacery behawioralne</a>
                    <a href="/oferta/spacery-grupowe">Spacery grupowe</a>
                </div>
            </details>
        </div>
        <a href="/sklep">Sklep</a>
        <a href="/kontakt">Kontakt</a>
        <div class="social">
            <a href="https://www.facebook.com/profile.php?id=61579532473491">
                <Icon id="facebook" name="mdi:facebook" size="24"/>
            </a>
            <a href="https://instagram.com/pjeski_talarka_/">
                <Icon id="instagram" name="mdi:instagram"  size="24"/>
            </a>
        </div>
    </nav>
</header>

<style is:global>
#instagram {
    color: white;
    border-radius: 0.45rem;
    background: linear-gradient(45deg, #405de6, #5851db, #883ab4, #c13584, #e1306c, #fd1d1d);
}
#facebook {
    color: #405de6;
    /* background: linear-gradient(45deg, #405de6, #5851db, #883ab4, #c13584, #e1306c, #fd1d1d); */
}
</style>

<style>
.dropdown {
    position: relative;
}

.dropdown details {
    position: relative;
}
details summary #chevron {
    transform: rotate(0deg);
    transition: all 0.1s ease;
}
details[open]summary #chevron {
    transform: rotate(180deg);
}
.dropdown summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: inherit;
    padding: 0.2rem 0.35rem;
    border-radius: 0.35rem;
}

.dropdown summary::-webkit-details-marker {
    display: none;
}

.dropdown-menu {
    position: absolute;
    left: 0;
    top: calc(100% + 0.35rem);
    background: var(--color-bg);
    border: 1px solid var(--color-shadow);
    box-shadow: 0 0 10px rgba(0,0,0,0.15);
    border-radius: 0.5rem;
    min-width: 220px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 10;
    display: flex;
    flex-direction: column;
}

.dropdown-menu a {
    padding: 0.7rem 1rem;
    color: inherit;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.dropdown-menu a:last-child {
    border-bottom: 0;
}

.dropdown-menu a:hover {
    background: rgba(255,255,255,0.08);
}

.dropdown:hover .dropdown-menu,
.dropdown details[open] .dropdown-menu,
.dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.social {
    display: flex;
    gap: 1rem;
}
a:hover {
    scale: 1.01;
}
#facebook:hover, #instagram:hover{
    filter:drop-shadow(0.3px 0.3px 0.8px rgb(68, 68, 68));
    scale: 1.1;
}

#back {
    background-color: var(--color-bg);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    width: 100%;
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
    position: sticky;
    top: 0px;
    z-index: 4;
}


#logo_i_tytul
{
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
    text-decoration: none;
    scale: 1.0;
}
img {
    aspect-ratio: 1;
    height: 5rem;
}
nav {
    display: flex;
    gap: 1rem;
    align-items: center;
    transition: all 1s ease;
}
#hamburger {
    display: none;
    border: 0px;
    background-color: inherit;
    cursor: pointer;
}
h1 {
    margin: 0px;
    font-size: clamp(0.9rem, 2dvw, 1.6rem);
    margin-bottom: 0.15rem;
}
h2 {
    margin: 0px;
    font-size: clamp(0.6rem, 0.9dvw, 1rem);
    margin-top: 0;
}



/* Extra small devices (phones, 600px and down) */
@media only screen and (max-width: 700px) {
    nav {
        position: fixed;
        right: 10px;
        flex-direction: column;
        background-color: var(--color-bg);
        
        gap: 3rem;
        top: 5.5rem;
        padding: 2rem;
        border-radius: 0.5rem;
        filter: drop-shadow(1px 1px 3px var(--color-shadow));
        /* display: none; */
        transition: 0.1s;
        translate: 0px 20px;
        opacity: 1;
    }
    
    #hamburger {
        display: block;
    }
    a {
        width: 100%;
        font-size: 1.4rem;
    }
    nav.visible {
        translate: 100px;
        opacity: 0;
    }
    .dropdown {
        width: 100%;
    }
    .dropdown details {
        width: 100%;
    }
    .dropdown summary {
        width: 100%;
        justify-content: space-between;
        padding: 0.0rem;
        font-size: 1.4rem;
    }
    .dropdown-menu {
        position: static;
        transform: none;
        opacity: 1;
        visibility: visible;
        background: transparent;
        border: none;
        box-shadow: none;
        padding-left: 0.2rem;
    }
    .dropdown-menu a {
        padding: 0.6rem 0.5rem;
        border: none;
        border-radius: 0.35rem;
        background: rgba(255,255,255,0.05);
        margin: 0.15rem 0;
    }
    .dropdown-menu a:hover {
        background: rgba(255,255,255,0.12);
    }
    .social {
        font-size: 6rem;
    }
}

</style>